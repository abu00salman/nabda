{
  "name": "nabda-desktop",
  "productName": "Nabda",
  "version": "2.0.0",
  "description": "تطبيق نبضة لسطح المكتب (Windows و macOS)",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.playnabda.desktop",
    "productName": "Nabda",
    "copyright": "Copyright © Nabda",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nabda"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false
    }
  }
}
